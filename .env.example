# ============================================================================
# .env.example —— 密钥模板（★ 这个文件是给别人看的"样子"）
# ============================================================================
# 用法（在cmd里做，打开cmd：按 Win 键 → 输入 cmd → 回车）：
#   cd /d "E:\8月3日Ai学习计划\每日练习\eval_system"
#   copy .env.example .env
#   然后用记事本打开 .env，把 key 填进去
#
# ★★ 两条铁律 ★★
#   1. 真正填了 key 的文件叫【.env】，它已经被 .gitignore 挡住，**永远不会上传到 GitHub**。
#   2. 绝对不要把 key 直接写在 .py 代码里 —— 那是密钥泄露最常见的方式。
#
# 哪些模型可以不填？随便。填了几个 key，评测就自动跑几个模型，
# 没填的会被标成"无key(跳过)"，不会报错。
# ============================================================================

# ---------- 模型 1：DeepSeek ----------
# 申请地址：platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- 模型 2：智谱 GLM（有免费档，适合练手）----------
# 申请地址：open.bigmodel.cn
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---------- 模型 3：自己加（通义 / 月之暗面 / 任何 OpenAI 兼容服务）----------
# ★ 这里我故意留空，不帮你填死。
#   原因：我没在你机器上验证过这几家的接口地址，按规矩不能凭记忆编一个给你。
#   要用哪家，打开它官方文档的"OpenAI 兼容接入"那一节，
#   把下面的地址和模型名照抄过来就行。填了它就会自动加入评测。
THIRD_NAME=
THIRD_API_KEY=
THIRD_MODEL=
THIRD_BASE_URL=
